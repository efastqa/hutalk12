rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[A-Za-z0-9_.:@-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Listing validation (supports guest + signed-in sellers)
    function isValidListing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             data.location is string && data.location.size() > 0 && data.location.size() <= 100 &&
             (!('status' in data) || data.status in ['approved', 'pending', 'rejected']) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 20000)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('views' in data) || (data.views is number && data.views >= 0));
    }

    function isValidListingUpdate(data) {
      return (!('title' in data) || (data.title is string && data.title.size() > 0 && data.title.size() <= 200)) &&
             (!('category' in data) || (data.category is string && data.category.size() > 0 && data.category.size() <= 100)) &&
             (!('price' in data) || (data.price is number && data.price >= 0)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50)) &&
             (!('location' in data) || (data.location is string && data.location.size() > 0 && data.location.size() <= 100)) &&
             (!('status' in data) || data.status in ['approved', 'pending', 'rejected']) &&
             (!('availabilityStatus' in data) || data.availabilityStatus in ['available', 'reserved', 'sold']) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 20000)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('views' in data) || (data.views is number && data.views >= 0));
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
             data.location is string && data.location.size() > 0 && data.location.size() <= 200 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('attendees' in data) || (data.attendees is number && data.attendees >= 0));
    }

    function isValidHeroContainer(data) {
      return (('ads' in data && data.ads is list && data.ads.size() <= 40) ||
              ('slides' in data && data.slides is list && data.slides.size() <= 40) ||
              ('settings' in data && data.settings is map) ||
              ('title' in data && data.title is string && data.title.size() > 0 && data.title.size() <= 200));
    }

    function isValidVideoReel(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('price' in data) || (data.price is number && data.price >= 0)) &&
             (!('views' in data) || (data.views is number && data.views >= 0));
    }

    function isValidEStore(data) {
      return data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 160 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
             (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('products' in data) || (data.products is list && data.products.size() <= 80));
    }

    function isValidReview(data) {
      return data.listingId is string && data.listingId.size() > 0 && data.listingId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000));
    }

    function isValidReport(data) {
      return data.listingId is string && data.listingId.size() > 0 && data.listingId.size() <= 128 &&
             data.listingTitle is string && data.listingTitle.size() > 0 && data.listingTitle.size() <= 200 &&
             data.reason in ['fraud_scam', 'incorrect_price', 'already_sold', 'duplicate', 'prohibited_item', 'other'] &&
             data.status in ['pending', 'reviewed', 'resolved', 'dismissed'] &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000));
    }

    function isValidUserRecord(data) {
      return (!('username' in data) || (data.username is string && data.username.size() > 0 && data.username.size() <= 100)) &&
             (!('fullname' in data) || (data.fullname is string && data.fullname.size() <= 120)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 256)) &&
             (!('twoFactorEnabled' in data) || data.twoFactorEnabled is bool) &&
             (!('twoFactorMethod' in data) || data.twoFactorMethod in ['sms', 'authenticator']) &&
             (!('twoFactorRecoveryCodes' in data) || (data.twoFactorRecoveryCodes is list && data.twoFactorRecoveryCodes.size() <= 20));
    }

    function isValidAdminConfig(data) {
      return (!('autoApprove' in data) || data.autoApprove is bool) &&
             (!('twoFactorEnabled' in data) || data.twoFactorEnabled is bool) &&
             (!('password' in data) || (data.password is string && data.password.size() > 0 && data.password.size() <= 128)) &&
             (!('twoFactorPhone' in data) || (data.twoFactorPhone is string && data.twoFactorPhone.size() <= 50)) &&
             (!('twoFactorMethod' in data) || data.twoFactorMethod in ['sms', 'authenticator']);
    }

    function isValidBuyerRequest(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
             data.maxBudget is number && data.maxBudget >= 0 &&
             data.buyerPhone is string && data.buyerPhone.size() > 0 && data.buyerPhone.size() <= 50 &&
             data.urgency in ['urgent', 'this_week', 'flexible'] &&
             data.status in ['open', 'fulfilled', 'closed'] &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
             (!('offers' in data) || (data.offers is list && data.offers.size() <= 100));
    }

    function isValidDonationCause(data) {
      return data.organizationName is string && data.organizationName.size() > 0 && data.organizationName.size() <= 160 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category in ['Hospitals & Medical', 'Blood & Emergency', 'Children & Schools', 'Food & Elders Relief', 'Community Infrastructure'] &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
             data.contactPhone is string && data.contactPhone.size() > 0 && data.contactPhone.size() <= 50 &&
             data.urgency in ['critical', 'urgent', 'ongoing'] &&
             data.status in ['active', 'fulfilled', 'paused'] &&
             (!('address' in data) || (data.address is string && data.address.size() <= 240)) &&
             (!('officialWebsite' in data) || (data.officialWebsite is string && data.officialWebsite.size() <= 300)) &&
             (!('bankDetailsNote' in data) || (data.bankDetailsNote is string && data.bankDetailsNote.size() <= 1000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('neededItems' in data) || (data.neededItems is list && data.neededItems.size() <= 25)) &&
             (!('pledges' in data) || (data.pledges is list && data.pledges.size() <= 200));
    }

    function isValidTravelBooking(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.bookingRef is string && data.bookingRef.size() > 0 && data.bookingRef.size() <= 40 &&
             data.packageId is string && data.packageId.size() > 0 && data.packageId.size() <= 128 &&
             data.packageTitle is string && data.packageTitle.size() > 0 && data.packageTitle.size() <= 200 &&
             data.category in ['Tour Packages', 'Safaris & Wildlife', 'Transfers & Chauffeurs', 'Boutique Stays'] &&
             data.destination is string && data.destination.size() > 0 && data.destination.size() <= 120 &&
             data.startDate is string && data.startDate.size() > 0 && data.startDate.size() <= 32 &&
             data.days is number && data.days >= 1 && data.days <= 30 &&
             data.adults is number && data.adults >= 1 && data.adults <= 30 &&
             (!('children' in data) || (data.children is number && data.children >= 0 && data.children <= 20)) &&
             data.pickupLocation is string && data.pickupLocation.size() > 0 && data.pickupLocation.size() <= 120 &&
             data.vehicleTier in ['Private Sedan', 'Luxury KDH Van', '4x4 Safari Jeep', 'VIP Coach'] &&
             (!('addons' in data) || (data.addons is list && data.addons.size() <= 10)) &&
             data.travelerName is string && data.travelerName.size() > 0 && data.travelerName.size() <= 120 &&
             data.travelerPhone is string && data.travelerPhone.size() > 0 && data.travelerPhone.size() <= 50 &&
             (!('travelerEmail' in data) || (data.travelerEmail is string && data.travelerEmail.size() <= 150)) &&
             (!('specialRequests' in data) || (data.specialRequests is string && data.specialRequests.size() <= 1500)) &&
             (!('baseAmountLkr' in data) || (data.baseAmountLkr is number && data.baseAmountLkr >= 0)) &&
             (!('adminAdjustmentLkr' in data) || data.adminAdjustmentLkr is number) &&
             (!('adminAdjustmentNote' in data) || (data.adminAdjustmentNote is string && data.adminAdjustmentNote.size() <= 300)) &&
             (!('assignedDriverName' in data) || (data.assignedDriverName is string && data.assignedDriverName.size() <= 120)) &&
             (!('assignedDriverPhone' in data) || (data.assignedDriverPhone is string && data.assignedDriverPhone.size() <= 50)) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1500)) &&
             data.totalLkr is number && data.totalLkr >= 0 &&
             (!('preferredCurrency' in data) || data.preferredCurrency in ['LKR', 'USD']) &&
             (!('usdExchangeRate' in data) || (data.usdExchangeRate is number && data.usdExchangeRate >= 50 && data.usdExchangeRate <= 2000)) &&
             data.status in ['pending', 'confirmed', 'cancelled'] &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTravelConfig(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.packages is list && data.packages.size() <= 60 &&
             data.vehicleTiers is list && data.vehicleTiers.size() <= 15 &&
             data.addons is list && data.addons.size() <= 30 &&
             (!('serviceFeePercent' in data) || (data.serviceFeePercent is number && data.serviceFeePercent >= 0 && data.serviceFeePercent <= 50)) &&
             (!('globalDiscountPercent' in data) || (data.globalDiscountPercent is number && data.globalDiscountPercent >= 0 && data.globalDiscountPercent <= 80)) &&
             (!('customTripBaseLkr' in data) || (data.customTripBaseLkr is number && data.customTripBaseLkr >= 0)) &&
             (!('customTripDailyLkr' in data) || (data.customTripDailyLkr is number && data.customTripDailyLkr >= 0)) &&
             (!('usdExchangeRateLkr' in data) || (data.usdExchangeRateLkr is number && data.usdExchangeRateLkr >= 50 && data.usdExchangeRateLkr <= 2000)) &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSocietyRequest(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.beneficiaryName is string && data.beneficiaryName.size() > 0 && data.beneficiaryName.size() <= 120 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category in [
               'Medical Help',
               'Education Help',
               'Emergency & Disaster Relief',
               'Food & Family Support',
               'Disability & Elder Care',
               'Livelihood & Tools Aid',
               'Other Community Need'
             ] &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 100 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 160)) &&
             data.urgency in ['critical', 'urgent', 'ongoing'] &&
             data.status in ['open', 'partially_helped', 'fulfilled'] &&
             (!('reviewStatus' in data) || data.reviewStatus in ['pending_review', 'approved', 'verified_proof', 'rejected']) &&
             (!('adminReviewNote' in data) || (data.adminReviewNote is string && data.adminReviewNote.size() <= 1000)) &&
             (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64)) &&
             (!('updatedAfterReview' in data) || data.updatedAfterReview is bool) &&
             data.contactPhone is string && data.contactPhone.size() > 0 && data.contactPhone.size() <= 50 &&
             data.story is string && data.story.size() > 0 && data.story.size() <= 5000 &&
             (!('neededAmountLkr' in data) || (data.neededAmountLkr is number && data.neededAmountLkr >= 0)) &&
             (!('receivedAmountLkr' in data) || (data.receivedAmountLkr is number && data.receivedAmountLkr >= 0)) &&
             (!('whatsappPhone' in data) || (data.whatsappPhone is string && data.whatsappPhone.size() <= 50)) &&
             (!('neededItemsSummary' in data) || (data.neededItemsSummary is string && data.neededItemsSummary.size() <= 500)) &&
             (!('bankOrPayDetails' in data) || (data.bankOrPayDetails is string && data.bankOrPayDetails.size() <= 1000)) &&
             (!('proofVerifiedNote' in data) || (data.proofVerifiedNote is string && data.proofVerifiedNote.size() <= 500)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 6)) &&
             (!('proofs' in data) || (data.proofs is list && data.proofs.size() <= 6)) &&
             (!('offers' in data) || (data.offers is list && data.offers.size() <= 200)) &&
             (!('offersCount' in data) || (data.offersCount is number && data.offersCount >= 0)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Master Gate helper: Get parent conversation document
    function getConversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() && (
        getConversation(conversationId).buyerId == request.auth.uid ||
        getConversation(conversationId).sellerId == request.auth.uid
      );
    }

    // Conversation schema validation blueprint
    function isValidConversation(data) {
      return data.listingId is string && data.listingId.size() > 0 && data.listingId.size() <= 128 &&
             data.listingTitle is string && data.listingTitle.size() > 0 && data.listingTitle.size() <= 200 &&
             data.buyerId is string && data.buyerId == request.auth.uid &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.buyerName is string && data.buyerName.size() <= 100 &&
             data.sellerName is string && data.sellerName.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
             (!('listingPrice' in data) || (data.listingPrice is number)) &&
             (!('listingImage' in data) || (data.listingImage is string && data.listingImage.size() <= 1000));
    }

    // Message schema validation blueprint
    function isValidMessage(data, conversationId) {
      return data.conversationId == conversationId &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Connection Health Check Collection
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Marketplace Listings
    match /listings/{listingId} {
      allow get, list: if true;
      allow create: if isValidId(listingId) && isValidListing(incoming());
      allow update: if isValidId(listingId) && isValidListingUpdate(incoming());
      allow delete: if isValidId(listingId);
    }

    // Marketplace Community Events
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isValidId(eventId) && isValidEvent(incoming());
      allow update: if isValidId(eventId) &&
        (!('title' in incoming()) || (incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200)) &&
        (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 4000));
      allow delete: if isValidId(eventId);
    }

    // Promotional Hero Banners & Promo Slides Settings
    match /hero_ads/{heroAdId} {
      allow get, list: if true;
      allow create, update: if isValidId(heroAdId) && isValidHeroContainer(incoming());
      allow delete: if isValidId(heroAdId);
    }

    // Video Stories & Inspection Reels
    match /video_reels/{reelId} {
      allow get, list: if true;
      allow create: if isValidId(reelId) && isValidVideoReel(incoming());
      allow update: if isValidId(reelId) &&
        (!('title' in incoming()) || (incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200)) &&
        (!('views' in incoming()) || (incoming().views is number && incoming().views >= 0));
      allow delete: if isValidId(reelId);
    }

    // Sri Lankan E-Stores & Online Merchant Directory
    match /estores/{storeId} {
      allow get, list: if true;
      allow create: if isValidId(storeId) && isValidEStore(incoming());
      allow update: if isValidId(storeId) &&
        (!('storeName' in incoming()) || (incoming().storeName is string && incoming().storeName.size() > 0 && incoming().storeName.size() <= 160)) &&
        (!('products' in incoming()) || (incoming().products is list && incoming().products.size() <= 80));
      allow delete: if isValidId(storeId);
    }

    // Administrative Configuration & Moderation
    match /admin_config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidId(configId) && isValidAdminConfig(incoming());
      allow delete: if isValidId(configId);
    }

    // Marketplace Users & Verification
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUserRecord(incoming());
      allow delete: if isValidId(userId);
    }

    // Customer Reviews & Seller Ratings
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update: if isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isValidId(reviewId);
    }

    // Customer Reports & Trust Safety Flags
    match /reports/{reportId} {
      allow get, list: if true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update: if isValidId(reportId) &&
        (!('status' in incoming()) || incoming().status in ['pending', 'reviewed', 'resolved', 'dismissed']);
      allow delete: if isValidId(reportId);
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);

      allow list: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);

      allow create: if isSignedIn() && isValidId(conversationId) &&
        incoming().buyerId == request.auth.uid &&
        isValidConversation(incoming()) &&
        incoming().keys().hasAll(['listingId', 'listingTitle', 'buyerId', 'sellerId', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() && isValidId(conversationId) &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid) &&
        incoming().buyerId == resource.data.buyerId &&
        incoming().sellerId == resource.data.sellerId &&
        incoming().listingId == resource.data.listingId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);

      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) &&
          isConversationParticipant(conversationId);

        allow list: if isValidId(conversationId) &&
          isConversationParticipant(conversationId);

        allow create: if isValidId(conversationId) && isValidId(messageId) &&
          isConversationParticipant(conversationId) &&
          incoming().senderId == request.auth.uid &&
          isValidMessage(incoming(), conversationId) &&
          incoming().keys().hasAll(['conversationId', 'senderId', 'senderName', 'text', 'createdAt']);

        allow update, delete: if false;
      }
    }

    // Wanted / Buyer Request Board ("Looking For")
    match /buyer_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId) && isValidBuyerRequest(incoming());
      allow update: if isValidId(requestId) &&
        (!('status' in incoming()) || incoming().status in ['open', 'fulfilled', 'closed']) &&
        (!('offers' in incoming()) || incoming().offers is list);
      allow delete: if isValidId(requestId);
    }

    // Sri Lanka Hospitals, Medical Aid & Charity Donations
    match /donations/{causeId} {
      allow get, list: if true;
      allow create: if isValidId(causeId) && isValidDonationCause(incoming());
      allow update: if isValidId(causeId) &&
        (!('status' in incoming()) || incoming().status in ['active', 'fulfilled', 'paused']) &&
        (!('pledges' in incoming()) || (incoming().pledges is list && incoming().pledges.size() <= 200));
      allow delete: if isValidId(causeId);
    }

    // Sri Lanka Travel & Tourism Booking System (HUTA IN) - Admin Protected
    match /travel_bookings/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(bookingId) && isValidTravelBooking(incoming());
      allow update: if isValidId(bookingId) &&
        isValidTravelBooking(incoming()) &&
        incoming().bookingRef == existing().bookingRef &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'startDate',
          'days',
          'pickupLocation',
          'vehicleTier',
          'baseAmountLkr',
          'adminAdjustmentLkr',
          'adminAdjustmentNote',
          'totalLkr',
          'assignedDriverName',
          'assignedDriverPhone',
          'adminNotes',
          'updatedAt'
        ]);
      allow delete: if isValidId(bookingId);
    }

    // Admin-Controlled Travel Pricing, Packages & Charges Configuration
    match /travel_config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidId(configId) && isValidTravelConfig(incoming());
      allow delete: if isValidId(configId);
    }

    // HUTA IN "Society" Community Medical, Education & Relief Help Hub
    match /society_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId) && isValidSocietyRequest(incoming());
      allow update: if isValidId(requestId) &&
        isValidSocietyRequest(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(requestId);
    }
  }
}
