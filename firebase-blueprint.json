{
  "entities": {
    "Listing": {
      "title": "Listing",
      "description": "A classified marketplace ad listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "pricingType": { "type": "string", "enum": ["fixed", "negotiable", "daily", "monthly", "starting_at", "hourly", "quote"] },
        "phone": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "isFeatured": { "type": "boolean" },
        "views": { "type": "number" },
        "verificationNotes": { "type": "string", "maxLength": 1000 },
        "verificationStatus": { "type": "string", "enum": ["unverified", "verified_with_customer", "deltas_found"] },
        "availabilityStatus": { "type": "string", "enum": ["available", "reserved", "sold"] },
        "sellerName": { "type": "string", "maxLength": 120 },
        "sellerRating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "whatsappClicks": { "type": "number" },
        "phoneClicks": { "type": "number" },
        "images": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "category", "price", "phone", "location", "status"]
    },
    "User": {
      "title": "User",
      "description": "Registered marketplace user profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "fullname": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "password": { "type": "string", "maxLength": 256 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "securityQuestion": { "type": "string", "maxLength": 200 },
        "securityAnswer": { "type": "string", "maxLength": 200 },
        "twoFactorEnabled": { "type": "boolean" },
        "twoFactorMethod": { "type": "string", "enum": ["sms", "authenticator"] },
        "twoFactorPhone": { "type": "string", "maxLength": 50 },
        "twoFactorRecoveryCodes": { "type": "array" },
        "isVerified": { "type": "boolean" },
        "created": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id"]
    },
    "Event": {
      "title": "Event",
      "description": "Cultural, motor, or community event in Sri Lanka.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 100 },
        "month": { "type": "string", "maxLength": 20 },
        "day": { "type": "string", "maxLength": 10 },
        "time": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "venue": { "type": "string", "maxLength": 200 },
        "image": { "type": "string", "maxLength": 2000 },
        "badge": { "type": "string", "maxLength": 100 },
        "price": { "type": "string", "maxLength": 100 },
        "isFree": { "type": "boolean" },
        "attendees": { "type": "number" },
        "description": { "type": "string", "maxLength": 4000 },
        "organizer": { "type": "string", "maxLength": 100 },
        "isSpotlight": { "type": "boolean" }
      },
      "required": ["id", "title", "category", "district", "location"]
    },
    "HeroAd": {
      "title": "HeroAd",
      "description": "Hero banner promotion item or configuration container (main, promo_slides).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "settings": { "type": "object" },
        "ads": { "type": "array" },
        "slides": { "type": "array" },
        "badge": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "highlightText": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 100 },
        "ctaAction": { "type": "string", "maxLength": 500 },
        "bgImage": { "type": "string" },
        "bgVideo": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "gradientTheme": { "type": "string", "maxLength": 50 },
        "animationType": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    },
    "PromoSlide": {
      "title": "PromoSlide",
      "description": "Admin-managed promo ad image slide displayed below Explore Categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string" },
        "badge": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "ctaText": { "type": "string", "maxLength": 100 },
        "ctaAction": { "type": "string", "maxLength": 500 },
        "showTextOverlay": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "imageUrl", "isActive"]
    },
    "VideoReel": {
      "title": "VideoReel",
      "description": "Short product walkthrough video story / inspection reel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "videoUrl": { "type": "string", "maxLength": 2000 },
        "posterImage": { "type": "string" },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "location": { "type": "string", "maxLength": 120 },
        "district": { "type": "string", "maxLength": 100 },
        "sellerName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 50 },
        "isVerified": { "type": "boolean" },
        "specsSummary": { "type": "string", "maxLength": 500 },
        "listingId": { "type": "string", "maxLength": 128 },
        "isActive": { "type": "boolean" },
        "views": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title"]
    },
    "EStore": {
      "title": "EStore",
      "description": "Sri Lankan online merchant storefront and product catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 4000 },
        "category": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "websiteUrl": { "type": "string", "maxLength": 500 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "logo": { "type": "string" },
        "bannerImage": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isVerifiedMerchant": { "type": "boolean" },
        "deliveryInfo": { "type": "string", "maxLength": 400 },
        "returnPolicy": { "type": "string", "maxLength": 400 },
        "foundedYear": { "type": "string", "maxLength": 16 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "products": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "storeName", "category", "district"]
    },
    "ListingReview": {
      "title": "ListingReview",
      "description": "Buyer rating and review on a marketplace listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "verifiedBuyer": { "type": "boolean" },
        "date": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "listingId", "authorName", "rating"]
    },
    "ListingReport": {
      "title": "ListingReport",
      "description": "Trust and safety user report on a marketplace listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "listingTitle": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "enum": ["fraud_scam", "incorrect_price", "already_sold", "duplicate", "prohibited_item", "other"] },
        "details": { "type": "string", "maxLength": 2000 },
        "reporterContact": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "listingId", "listingTitle", "reason", "status"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Platform settings including moderation, 2FA, and password configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "autoApprove": { "type": "boolean" },
        "password": { "type": "string", "maxLength": 128 },
        "adminPasswordHash": { "type": "string", "maxLength": 256 },
        "twoFactorEnabled": { "type": "boolean" },
        "twoFactorPhone": { "type": "string", "maxLength": 50 },
        "twoFactorMethod": { "type": "string", "enum": ["sms", "authenticator"] },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat thread between a buyer and a seller regarding a marketplace listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "listingTitle": { "type": "string", "maxLength": 200 },
        "listingPrice": { "type": "number" },
        "listingImage": { "type": "string", "maxLength": 1000 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["listingId", "listingTitle", "buyerId", "sellerId", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual chat message in a conversation thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 2000, "minLength": 1 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["conversationId", "senderId", "senderName", "text", "createdAt"]
    },
    "BuyerRequest": {
      "title": "BuyerRequest",
      "description": "A Wanted / Looking For buyer request posted on HUTA.LK with seller offers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 120 },
        "maxBudget": { "type": "number" },
        "urgency": { "type": "string", "enum": ["urgent", "this_week", "flexible"] },
        "description": { "type": "string", "maxLength": 3000 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "buyerPhone": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["open", "fulfilled", "closed"] },
        "offersCount": { "type": "number" },
        "offers": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "category", "district", "maxBudget", "buyerPhone", "status", "createdAt"]
    },
    "DonationCause": {
      "title": "DonationCause",
      "description": "Verified Sri Lanka hospital, medical aid, children's home, or emergency relief donation drive.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationName": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Hospitals & Medical", "Blood & Emergency", "Children & Schools", "Food & Elders Relief", "Community Infrastructure"] },
        "district": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 240 },
        "officialWebsite": { "type": "string", "maxLength": 300 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "contactPerson": { "type": "string", "maxLength": 120 },
        "urgency": { "type": "string", "enum": ["critical", "urgent", "ongoing"] },
        "status": { "type": "string", "enum": ["active", "fulfilled", "paused"] },
        "verifiedOfficial": { "type": "boolean" },
        "bankDetailsNote": { "type": "string", "maxLength": 1000 },
        "neededItems": { "type": "array" },
        "description": { "type": "string", "maxLength": 4000 },
        "image": { "type": "string", "maxLength": 1000 },
        "pledgeCount": { "type": "number" },
        "totalPledgedLkr": { "type": "number" },
        "pledges": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "organizationName", "title", "category", "district", "contactPhone", "urgency", "status", "createdAt"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check document to verify Cloud Firestore connectivity upon app boot.",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    },
    "TravelBooking": {
      "title": "TravelBooking",
      "description": "Sri Lanka travel tour, safari jeep, chauffeur transfer, or boutique stay booking made on HUTA IN.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookingRef": { "type": "string", "maxLength": 40 },
        "packageId": { "type": "string", "maxLength": 128 },
        "packageTitle": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Tour Packages", "Safaris & Wildlife", "Transfers & Chauffeurs", "Boutique Stays"] },
        "destination": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 32 },
        "days": { "type": "number" },
        "adults": { "type": "number" },
        "children": { "type": "number" },
        "pickupLocation": { "type": "string", "maxLength": 120 },
        "vehicleTier": { "type": "string", "enum": ["Private Sedan", "Luxury KDH Van", "4x4 Safari Jeep", "VIP Coach"] },
        "addons": { "type": "array" },
        "travelerName": { "type": "string", "maxLength": 120 },
        "travelerPhone": { "type": "string", "maxLength": 50 },
        "travelerEmail": { "type": "string", "maxLength": 150 },
        "specialRequests": { "type": "string", "maxLength": 1500 },
        "baseAmountLkr": { "type": "number" },
        "adminAdjustmentLkr": { "type": "number" },
        "adminAdjustmentNote": { "type": "string", "maxLength": 300 },
        "assignedDriverName": { "type": "string", "maxLength": 120 },
        "assignedDriverPhone": { "type": "string", "maxLength": 50 },
        "adminNotes": { "type": "string", "maxLength": 1500 },
        "totalLkr": { "type": "number" },
        "preferredCurrency": { "type": "string", "enum": ["LKR", "USD"] },
        "usdExchangeRate": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "bookingRef", "packageId", "packageTitle", "category", "destination", "startDate", "days", "adults", "pickupLocation", "vehicleTier", "travelerName", "travelerPhone", "totalLkr", "status", "createdAt"]
    },
    "TravelConfig": {
      "title": "TravelConfig",
      "description": "Admin-managed Sri Lanka travel packages, vehicle tier rates, add-ons, and pricing configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "packages": { "type": "array" },
        "vehicleTiers": { "type": "array" },
        "addons": { "type": "array" },
        "serviceFeePercent": { "type": "number" },
        "globalDiscountPercent": { "type": "number" },
        "customTripBaseLkr": { "type": "number" },
        "customTripDailyLkr": { "type": "number" },
        "usdExchangeRateLkr": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "packages", "vehicleTiers", "addons", "updatedAt"]
    },
    "SocietyHelpRequest": {
      "title": "SocietyHelpRequest",
      "description": "Individual medical, education, food, or emergency relief help appeal with photos and supporting proof documents in HUTA IN Society.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "beneficiaryName": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Medical Help", "Education Help", "Emergency & Disaster Relief", "Food & Family Support", "Disability & Elder Care", "Livelihood & Tools Aid", "Other Community Need"] },
        "district": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 160 },
        "urgency": { "type": "string", "enum": ["critical", "urgent", "ongoing"] },
        "status": { "type": "string", "enum": ["open", "partially_helped", "fulfilled"] },
        "neededAmountLkr": { "type": "number" },
        "receivedAmountLkr": { "type": "number" },
        "neededItemsSummary": { "type": "string", "maxLength": 500 },
        "story": { "type": "string", "maxLength": 5000 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "whatsappPhone": { "type": "string", "maxLength": 50 },
        "bankOrPayDetails": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "proofs": { "type": "array" },
        "proofVerifiedNote": { "type": "string", "maxLength": 500 },
        "offersCount": { "type": "number" },
        "offers": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "beneficiaryName", "title", "category", "district", "urgency", "status", "story", "contactPhone", "createdAt"]
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/TestConnection" },
      "description": "Health check document used by testConnection() upon initial boot."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Classified ad listings collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts and authentication records."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Community and marketplace events collection."
    },
    "/hero_ads/{heroAdId}": {
      "schema": { "$ref": "#/entities/HeroAd" },
      "description": "Promotional hero banners and promo slides configuration documents."
    },
    "/video_reels/{reelId}": {
      "schema": { "$ref": "#/entities/VideoReel" },
      "description": "Short video stories and inspection reels."
    },
    "/estores/{storeId}": {
      "schema": { "$ref": "#/entities/EStore" },
      "description": "Sri Lankan online merchant storefronts and product catalogs."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ListingReview" },
      "description": "Customer reviews and seller ratings for listings."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ListingReport" },
      "description": "Trust and safety user flags on listings."
    },
    "/admin_config/{configId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "Master administrative settings and configurations."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Collection of top-level conversation threads between buyers and sellers."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Subcollection of chat messages belonging to a conversation."
    },
    "/buyer_requests/{requestId}": {
      "schema": { "$ref": "#/entities/BuyerRequest" },
      "description": "Wanted / Looking For buyer request board posts and seller offers."
    },
    "/donations/{causeId}": {
      "schema": { "$ref": "#/entities/DonationCause" },
      "description": "Verified Sri Lanka hospital, charity, and emergency relief donation causes and pledges."
    },
    "/travel_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/TravelBooking" },
      "description": "Sri Lanka travel packages, wildlife safaris, chauffeur transfers, and boutique stay reservations."
    },
    "/travel_config/{configId}": {
      "schema": { "$ref": "#/entities/TravelConfig" },
      "description": "Admin-managed Sri Lanka travel packages, charges, add-on rates, and vehicle tier fees."
    },
    "/society_requests/{requestId}": {
      "schema": { "$ref": "#/entities/SocietyHelpRequest" },
      "description": "HUTA IN Society individual medical, education, and relief help appeals with images and proof documents."
    }
  }
}
